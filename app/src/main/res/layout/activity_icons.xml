<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView android:id="@+id/query" style="@style/ScreenTitle" />

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:numColumns="4" android:stretchMode="columnWidth"
        android:listSelector="@android:color/transparent"
        android:clipChildren="false" android:clipToPadding="false"
        android:padding="8dp" android:verticalSpacing="6dp" android:horizontalSpacing="6dp" />

    <TextView android:id="@+id/hint" style="@style/Hint" />
</LinearLayout>
