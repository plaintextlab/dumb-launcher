<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants">

    <!-- Clock at the top, big. -->
    <LinearLayout
        android:id="@+id/clockBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" android:gravity="center_horizontal">

        <TextClock
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textSize="92sp" android:textColor="@color/fg" />

        <TextClock
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM" android:format24Hour="EEEE, d MMMM"
            android:textSize="22sp" android:textColor="@color/dim" />
    </LinearLayout>

    <!-- Missed calls, messages and other notifications: icon + count. -->
    <LinearLayout
        android:id="@+id/notifs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal" android:gravity="center" />

    <include layout="@layout/view_music" />

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- D-pad cross: shows which app each arrow key opens. -->
    <LinearLayout
        android:id="@+id/dpad"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="6dp"
        android:orientation="vertical" android:gravity="center_horizontal">

        <include android:id="@+id/sc_up" layout="@layout/item_shortcut" />

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <include android:id="@+id/sc_left" layout="@layout/item_shortcut" />

            <TextView
                android:layout_width="40dp" android:layout_height="40dp"
                android:gravity="center" android:text="●"
                android:textSize="22sp" android:textColor="@color/dim" />

            <include android:id="@+id/sc_right" layout="@layout/item_shortcut" />
        </LinearLayout>

        <include android:id="@+id/sc_down" layout="@layout/item_shortcut" />
    </LinearLayout>

    <!-- Dock: what keys 1-5 open (your picks, or your most used apps). -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" android:paddingHorizontal="8dp"
        android:orientation="horizontal" />

    <TextView android:id="@+id/hint" style="@style/Hint" />
</LinearLayout>
