<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/clockBox"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center">

        <TextClock
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="HH:mm"
            android:textSize="72sp" android:textColor="@color/fg" />

        <TextClock
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM"
            android:textSize="22sp" android:textColor="@color/dim" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center"
            android:textSize="20sp" android:textColor="@color/focus" />
    </LinearLayout>

    <!-- D-pad cross: shows which app each arrow key opens. -->
    <LinearLayout
        android:id="@+id/dpad"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="12dp"
        android:orientation="vertical" android:gravity="center_horizontal">

        <include android:id="@+id/sc_up" layout="@layout/item_shortcut" />

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <include android:id="@+id/sc_left" layout="@layout/item_shortcut" />

            <TextView
                android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:text="●"
                android:textSize="22sp" android:textColor="@color/dim" />

            <include android:id="@+id/sc_right" layout="@layout/item_shortcut" />
        </LinearLayout>

        <include android:id="@+id/sc_down" layout="@layout/item_shortcut" />
    </LinearLayout>

    <TextView android:id="@+id/hint" style="@style/Hint" />
</LinearLayout>
