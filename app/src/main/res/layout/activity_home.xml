<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants">

    <!-- Clock at the top, big. -->
    <LinearLayout
        android:id="@+id/clockBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:paddingHorizontal="20dp"
        android:orientation="vertical" android:gravity="start">

        <TextClock
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="h:mm" android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-light" android:letterSpacing="-0.03"
            android:textSize="88sp" android:textColor="@color/fg"
            android:shadowColor="@color/shadow" android:shadowRadius="12" />

        <TextClock
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:format12Hour="EEEE, d MMMM" android:format24Hour="EEEE, d MMMM"
            android:fontFamily="sans-serif-light"
            android:textSize="22sp" android:textColor="@color/fg"
            android:shadowColor="@color/shadow" android:shadowRadius="8" />
    </LinearLayout>

    <!-- Missed calls, messages and other notifications: icon + count. -->
    <LinearLayout
        android:id="@+id/notifs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l" android:paddingHorizontal="16dp"
        android:orientation="horizontal" android:gravity="start" />

    <include layout="@layout/view_music" />

    <!-- Metro style: the tile Start screen replaces everything above and below. -->
    <ScrollView
        android:id="@+id/startScroll"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scrollbars="none" android:overScrollMode="never" android:visibility="gone">

        <LinearLayout
            android:id="@+id/startColumn"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp" android:paddingTop="6dp" />
    </ScrollView>

    <Space android:id="@+id/spacer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- D-pad cross: shows which app each arrow key opens. -->
    <LinearLayout
        android:id="@+id/dpad"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="6dp"
        android:orientation="vertical" android:gravity="center_horizontal">

        <include android:id="@+id/sc_up" layout="@layout/item_shortcut" />

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <include android:id="@+id/sc_left" layout="@layout/item_shortcut" />

            <TextView
                android:layout_width="40dp" android:layout_height="40dp"
                android:gravity="center" android:text="●"
                android:textSize="10sp" android:textColor="@color/dim" />

            <include android:id="@+id/sc_right" layout="@layout/item_shortcut" />
        </LinearLayout>

        <include android:id="@+id/sc_down" layout="@layout/item_shortcut" />
    </LinearLayout>

    <!-- Dock: what keys 1-5 open (your picks, or your most used apps). -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_m" android:layout_marginBottom="@dimen/space_m"
        android:background="@drawable/bg_card"
        android:paddingHorizontal="@dimen/space_xs" android:paddingVertical="@dimen/space_s"
        android:orientation="horizontal" />

    <TextView android:id="@+id/hint" style="@style/Hint" />
</LinearLayout>
