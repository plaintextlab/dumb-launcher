<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="10dp" android:textSize="20sp" android:textStyle="bold"
        android:text="Menu" />

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:numColumns="3" android:stretchMode="columnWidth"
        android:clipChildren="false" android:clipToPadding="false"
        android:listSelector="@android:color/transparent"
        android:padding="4dp" android:verticalSpacing="4dp" android:horizontalSpacing="4dp" />

    <TextView android:id="@+id/hint" style="@style/Hint" />
</LinearLayout>
