<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing on Home: album art, title / artist, the player's icon and how far into the song.
     Tap (or ▲) for the music popup with the controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_m" android:layout_marginTop="@dimen/space_l"
    android:background="@drawable/bg_card"
    android:paddingHorizontal="@dimen/space_m" android:paddingTop="@dimen/space_m" android:paddingBottom="10dp"
    android:clickable="true" android:focusable="false"
    android:contentDescription="Now playing. Tap for music controls"
    android:orientation="vertical" android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <ImageView
            android:id="@+id/musicArt"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_art" android:clipToOutline="true"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/space_m" android:orientation="vertical">

            <TextView
                android:id="@+id/musicTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp" android:textColor="@color/fg" />

            <TextView
                android:id="@+id/musicArtist"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:textSize="13sp" android:textColor="@color/dim" />
        </LinearLayout>

        <ImageView
            android:id="@+id/musicPlaying"
            android:layout_width="18dp" android:layout_height="18dp"
            android:layout_marginStart="@dimen/space_s"
            android:src="@drawable/ic_pause" android:alpha="0.7"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/musicApp"
            android:layout_width="26dp" android:layout_height="26dp"
            android:layout_marginStart="@dimen/space_s"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/musicProgress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:max="1000" android:progress="0"
        android:progressBackgroundTint="#33FFFFFF" />
</LinearLayout>
