<?xml version="1.0" encoding="utf-8"?>
<!-- Music widget on Home: album art, title/artist, prev / play-pause / next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/music"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_m" android:layout_marginTop="@dimen/space_l"
    android:background="@drawable/bg_card" android:padding="@dimen/space_m"
    android:orientation="vertical" android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <ImageView
            android:id="@+id/musicArt"
            android:layout_width="52dp" android:layout_height="52dp"
            android:background="@drawable/bg_art" android:clipToOutline="true"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/space_m" android:orientation="vertical">

            <TextView
                android:id="@+id/musicTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp" android:textColor="@color/fg" />

            <TextView
                android:id="@+id/musicArtist"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:textSize="13sp" android:textColor="@color/dim" />
        </LinearLayout>

        <ImageView
            android:id="@+id/musicPrev"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_prev"
            android:focusable="false" android:contentDescription="Previous" />

        <ImageView
            android:id="@+id/musicPlay"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_play"
            android:focusable="false" android:contentDescription="Play or pause" />

        <ImageView
            android:id="@+id/musicNext"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_next"
            android:focusable="false" android:contentDescription="Next" />
    </LinearLayout>

</LinearLayout>
