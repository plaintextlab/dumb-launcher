<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView android:id="@+id/query" style="@style/ScreenTitle" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:listSelector="@android:color/transparent"
        android:divider="@null" android:dividerHeight="0dp"
        android:clipChildren="false" />

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:numColumns="3" android:stretchMode="columnWidth"
        android:listSelector="@android:color/transparent"
        android:clipChildren="false" android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_s" android:paddingBottom="@dimen/space_s"
        android:verticalSpacing="@dimen/space_xs" android:horizontalSpacing="@dimen/space_xs"
        android:visibility="gone" />

    <TextView android:id="@+id/hint" style="@style/Hint" />
</LinearLayout>
