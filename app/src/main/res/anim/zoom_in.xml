<?xml version="1.0" encoding="utf-8"?>
<!-- Menu opens by growing out of the centre, S60 style. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220" android:interpolator="@android:interpolator/decelerate_cubic">
    <scale android:fromXScale="0.85" android:toXScale="1" android:fromYScale="0.85" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="0" android:toAlpha="1" />
</set>
